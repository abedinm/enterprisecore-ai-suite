{
  "title": "EnterpriseCore — Billing",
  "uid": "ec-billing",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["enterprisecore", "billing"],
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "plan",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ec_subscription_count, plan)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "Plan"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active subscriptions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ec_subscription_count{status=\"active\",plan=~\"$plan\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MRR (USD)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ec_subscription_mrr_usd{plan=~\"$plan\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trialing tenants",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ec_subscription_count{status=\"trialing\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Past-due tenants",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ec_subscription_count{status=\"past_due\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Subscriptions by plan",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plan) (ec_subscription_count{status=\"active\"})",
          "legendFormat": "{{plan}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "New + churned subscriptions / day",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_subscriptions_created_total[1d]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "expr": "sum(increase(ec_subscriptions_cancelled_total[1d]))",
          "legendFormat": "cancelled"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Stripe webhook processing",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(ec_stripe_events_total[5m]))",
          "legendFormat": "{{event_type}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ec_stripe_events_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Revenue / day (USD)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_revenue_usd_total[1d]))",
          "legendFormat": "revenue"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Past-due tenants (snapshot)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "ec_subscription_count{status=\"past_due\"}",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
