{
  "title": "EnterpriseCore — AI",
  "uid": "ec-ai",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["enterprisecore", "ai"],
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ec_ai_calls_total, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "Provider"
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ec_ai_calls_total{provider=~\"$provider\"}, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "Model"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AI calls (last 24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_ai_calls_total{provider=~\"$provider\",model=~\"$model\"}[1d]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI spend (last 24h, USD)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_ai_cost_usd_total{provider=~\"$provider\",model=~\"$model\"}[1d]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI success rate (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_ai_calls_total{success=\"true\",provider=~\"$provider\",model=~\"$model\"}[1d])) / sum(increase(ec_ai_calls_total{provider=~\"$provider\",model=~\"$model\"}[1d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens in (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec_ai_tokens_in_total{provider=~\"$provider\",model=~\"$model\"}[1d]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI calls / min by feature",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (feature) (rate(ec_ai_calls_total{provider=~\"$provider\",model=~\"$model\"}[1m])) * 60",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI latency p50 / p95 / p99 (by model)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(ec_ai_latency_seconds_bucket{provider=~\"$provider\",model=~\"$model\"}[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(ec_ai_latency_seconds_bucket{provider=~\"$provider\",model=~\"$model\"}[5m])))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(ec_ai_latency_seconds_bucket{provider=~\"$provider\",model=~\"$model\"}[5m])))",
          "legendFormat": "p99 {{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failure rate by provider",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(ec_ai_calls_total{success=\"false\",provider=~\"$provider\"}[5m])) / sum by (provider) (rate(ec_ai_calls_total{provider=~\"$provider\"}[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spend / hour by provider",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(ec_ai_cost_usd_total{provider=~\"$provider\"}[1h]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top 20 model usage (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (provider, model) (increase(ec_ai_calls_total{provider=~\"$provider\"}[1d])))",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
