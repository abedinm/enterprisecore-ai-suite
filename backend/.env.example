# Copy to .env and fill in
APP_NAME=EnterpriseCore AI Suite
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8765

# Set to "postgres" for PostgreSQL, "sqlite" (default) for local file
DB_BACKEND=sqlite
SQLITE_PATH=storage/enterprisecore.db
POSTGRES_DSN=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprisecore

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-strong-random-64-bytes
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=10
ENCRYPTION_KEY=replace-with-fernet-key-44-bytes

# AI providers (user brings own key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
AI_DEFAULT_PROVIDER=anthropic

# CORS — comma-separated origins for the React dev server / web build
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://./

# License (optional; empty disables enforcement in dev)
LICENSE_KEY=

# Defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
